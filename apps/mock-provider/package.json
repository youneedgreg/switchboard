{
  "name": "@switchboard/mock-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@switchboard/core": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
