# Comma-separated bearer tokens accepted by the gateway (Week 3 replaces this with real keys).
# Generate one with: openssl rand -hex 24
GATEWAY_API_KEYS=

# Optional real providers. Without them only the mock provider is available.
MISTRAL_API_KEY=
GROQ_API_KEY=

# Point at a separately running mock provider; unset = run the mock in-process.
MOCK_BASE_URL=

PORT=8787
